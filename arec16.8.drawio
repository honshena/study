ot; style=&quot;&quot;&gt; &lt;/font&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;child&lt;/span&gt;&lt;font color=&quot;#abb2bf&quot; style=&quot;&quot;&gt;)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
