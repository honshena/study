        <mxCell id="hFfkquWFA9sH2mhaJBzf-4" value="&lt;div style=&quot;color: rgb(171, 178, 191); font-family: &amp;quot;Fira code&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 18px; line-height: 24px; white-space: pre;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;ReactRoot&lt;/span&gt;.&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;prototype&lt;/span&gt;.&lt;span style=&quot;color: rgb(97, 175, 239); font-style: italic;&quot;&gt;render&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191); font-family: &amp;quot;Fira code&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 18px; line-height: 24px; white-space: pre;&quot;&gt;&lt;span style=&quot;color: rgb(97, 175, 239); font-style: italic; background-color: rgb(255, 255, 255);&quot;&gt;(children, callback)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191); font-family: &amp;quot;Fira code&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 18px; line-height: 24px; white-space: pre;&quot;&gt;&lt;div style=&quot;line-height: 24px;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: #e5c07b;&quot;&gt;work&lt;/span&gt; &lt;span style=&quot;color: #2bbac5;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #d55fde;&quot;&gt;new&lt;/span&gt; &lt;span style=&quot;color: #61afef;font-style: italic;&quot;&gt;ReactWork&lt;/span&gt;();&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 24px;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;调用&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;work&lt;/span&gt;.&lt;span style=&quot;color: rgb(97, 175, 239); font-style: italic;&quot;&gt;then&lt;/span&gt;(&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;callback&lt;/span&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 24px;&quot;&gt;&lt;div style=&quot;line-height: 24px;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: #61afef;font-style: italic;&quot;&gt;updateContainer&lt;/span&gt;(&lt;span style=&quot;color: #ef596f;&quot;&gt;children(App)&lt;/span&gt;, &lt;span style=&quot;color: #ef596f;&quot;&gt;root(FiberRoot)&lt;/span&gt;, &lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 24px;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: #d19a66;&quot;&gt;null&lt;/span&gt;, &lt;span style=&quot;color: #e5c07b;&quot;&gt;work&lt;/span&gt;.&lt;span style=&quot;color: #ef596f;&quot;&gt;_onCommit&lt;/span&gt;);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 24px;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;返回work&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2610" y="5895" width="550" height="185" as="geometry" />
        </mxCell>
