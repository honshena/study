        <mxCell id="S1GNeYo4WOAbKDjL4fGL-65" value="&lt;div style=&quot;color: rgb(171, 178, 191); font-family: &amp;quot;Fira code&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 18px; line-height: 24px; white-space: pre;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;(cotr) =&amp;gt; lazyType&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;cotr: () =&amp;gt; thenable对象&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;lazyType&lt;/span&gt; &lt;span style=&quot;color: rgb(43, 186, 197);&quot;&gt;=&lt;/span&gt; {&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #ef596f;&quot;&gt;$$typeof&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;REACT_LAZY_TYPE&lt;/span&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #ef596f;&quot;&gt;_ctor&lt;/span&gt;: &lt;span style=&quot;color: #ef596f;&quot;&gt;ctor&lt;/span&gt;, &lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;//lazy加载组件的方法&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;_status&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: rgb(43, 186, 197);&quot;&gt;-&lt;/span&gt;&lt;span style=&quot;color: rgb(209, 154, 102);&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(127, 132, 142); font-style: italic;&quot;&gt;//记录当前Thenable对象的状态&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #ef596f;&quot;&gt;_result&lt;/span&gt;: &lt;span style=&quot;color: #d19a66;&quot;&gt;null&lt;/span&gt;, &lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;//懒加载的组件&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp; };&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
