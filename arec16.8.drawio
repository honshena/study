        <mxCell id="S1GNeYo4WOAbKDjL4fGL-183" value="&lt;div style=&quot;font-family: &amp;quot;Fira code&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 18px; line-height: 24px; white-space: pre;&quot;&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;color: rgb(97, 175, 239); font-style: italic; background-color: rgb(255, 255, 255);&quot;&gt;FiberNode&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;(&lt;span style=&quot;color: rgb(239, 89, 111); font-style: italic;&quot;&gt;tag&lt;/span&gt;: &lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;WorkTag&lt;/span&gt;,&lt;span style=&quot;color: rgb(239, 89, 111); font-style: italic;&quot;&gt;pendingProps&lt;/span&gt;: &lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;mixed&lt;/span&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp; &lt;span style=&quot;color: #ef596f;font-style: italic;&quot;&gt;key&lt;/span&gt;: null | &lt;span style=&quot;color: #e5c07b;&quot;&gt;string&lt;/span&gt;,&lt;span style=&quot;color: rgb(239, 89, 111); font-style: italic;&quot;&gt;mode&lt;/span&gt;: &lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;TypeOfMode&lt;/span&gt;) &lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 24px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;background-color: rgb(255, 255, 255);&quot; color=&quot;#e5c07b&quot;&gt;给tag,mode,key,pengdingProps等赋值&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;background-color: rgb(255, 255, 255);&quot; color=&quot;#e5c07b&quot;&gt;其余的Fiber属性初始化为null&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
