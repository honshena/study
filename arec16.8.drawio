        <mxCell id="S1GNeYo4WOAbKDjL4fGL-63" value="&lt;div style=&quot;font-family: &amp;quot;Fira code&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 18px; line-height: 24px; white-space: pre;&quot;&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(127, 132, 142); font-style: italic;&quot;&gt;(type, compare) =&amp;gt; memo对象&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;font color=&quot;#abb2bf&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;font color=&quot;#d55fde&quot;&gt;&lt;i&gt;memo = &lt;/i&gt;&lt;/font&gt;&lt;font color=&quot;#abb2bf&quot;&gt;{&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #ef596f;&quot;&gt;$$typeof&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;REACT_MEMO_TYPE&lt;/span&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #ef596f;&quot;&gt;type: React Element&lt;/span&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #ef596f;&quot;&gt;compare&lt;/span&gt;: &lt;span style=&quot;color: #ef596f;&quot;&gt;compare || null&lt;/span&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp; };&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
