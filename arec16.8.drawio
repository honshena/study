        <mxCell id="hFfkquWFA9sH2mhaJBzf-6" value="&lt;div style=&quot;color: rgb(171, 178, 191); font-family: &amp;quot;Fira code&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 18px; line-height: 24px; white-space: pre;&quot;&gt;&lt;div style=&quot;line-height: 24px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: rgb(97, 175, 239); font-style: italic;&quot;&gt;ReactWork&lt;/span&gt;() {&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp; &lt;span style=&quot;color: #e5c07b;&quot;&gt;this&lt;/span&gt;.&lt;span style=&quot;color: #ef596f;&quot;&gt;_callbacks&lt;/span&gt; &lt;span style=&quot;color: #2bbac5;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #d19a66;&quot;&gt;null&lt;/span&gt;;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp; &lt;span style=&quot;color: #e5c07b;&quot;&gt;this&lt;/span&gt;.&lt;span style=&quot;color: #ef596f;&quot;&gt;_didCommit&lt;/span&gt; &lt;span style=&quot;color: #2bbac5;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #d19a66;&quot;&gt;false&lt;/span&gt;;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp; &lt;span style=&quot;color: #e5c07b;&quot;&gt;this&lt;/span&gt;.&lt;span style=&quot;color: #ef596f;&quot;&gt;_onCommit&lt;/span&gt; &lt;span style=&quot;color: #2bbac5;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #e5c07b;&quot;&gt;this&lt;/span&gt;.&lt;span style=&quot;color: #e5c07b;&quot;&gt;_onCommit&lt;/span&gt;.&lt;span style=&quot;color: #61afef;font-style: italic;&quot;&gt;bind&lt;/span&gt;(&lt;span style=&quot;color: #e5c07b;&quot;&gt;this&lt;/span&gt;);&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;}&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 24px;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: #e5c07b;&quot;&gt;ReactWork&lt;/span&gt;.&lt;span style=&quot;color: #ef596f;&quot;&gt;prototype={&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 24px;&quot;&gt;&lt;div style=&quot;line-height: 24px;&quot;&gt;&lt;span style=&quot;color: rgb(97, 175, 239); font-style: italic; background-color: rgb(255, 255, 255);&quot;&gt;then,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 24px;&quot;&gt;&lt;div style=&quot;line-height: 24px;&quot;&gt;&lt;span style=&quot;color: rgb(97, 175, 239); font-style: italic; background-color: rgb(255, 255, 255);&quot;&gt;_onCommit&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 24px;&quot;&gt;&lt;span style=&quot;color: rgb(239, 89, 111); background-color: rgb(255, 255, 255);&quot;&gt;}&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="3360" y="6110" width="510" height="230" as="geometry" />
        </mxCell>
        <mxCell id="hFfkquWFA9sH2mhaJBzf-8" value="&lt;div style=&quot;color: rgb(171, 178, 191); font-family: &amp;quot;Fira code&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 18px; line-height: 24px; white-space: pre;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;ReactWork&lt;/span&gt;.&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;prototype&lt;/span&gt;.&lt;span style=&quot;color: rgb(97, 175, 239); font-style: italic;&quot;&gt;then(onCommit)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191); font-family: &amp;quot;Fira code&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 18px; line-height: 24px; white-space: pre;&quot;&gt;&lt;span style=&quot;color: rgb(97, 175, 239); font-style: italic; background-color: rgb(255, 255, 255);&quot;&gt;如果didComit为true已经提交了则调用onCommit,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191); font-family: &amp;quot;Fira code&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 18px; line-height: 24px; white-space: pre;&quot;&gt;&lt;span style=&quot;color: rgb(97, 175, 239); font-style: italic; background-color: rgb(255, 255, 255);&quot;&gt;否则将callback加到this.callbacks数组中&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="4035" y="6180" width="430" height="90" as="geometry" />
        </mxCell>
        <mxCell id="hFfkquWFA9sH2mhaJBzf-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="hFfkquWFA9sH2mhaJBzf-10" target="hFfkquWFA9sH2mhaJBzf-16" edge="1">
