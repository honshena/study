        <mxCell id="S1GNeYo4WOAbKDjL4fGL-145" value="&lt;font color=&quot;#61afef&quot;&gt;断言只有一个合法&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#61afef&quot;&gt;的React Elementj节点&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="840" y="2995" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="S1GNeYo4WOAbKDjL4fGL-149" value="&lt;div style=&quot;font-family: &amp;quot;Fira code&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 18px; line-height: 24px; white-space: pre;&quot;&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: rgb(213, 95, 222); font-style: italic;&quot;&gt;type&lt;/span&gt; &lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;Fiber&lt;/span&gt; &lt;span style=&quot;color: rgb(43, 186, 197);&quot;&gt;=&lt;/span&gt; {&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;tag&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;WorkTag&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(127, 132, 142); font-style: italic;&quot;&gt;// 标记组件的类型&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;span style=&quot;color: #ef596f;&quot;&gt;key&lt;/span&gt;: null | &lt;span style=&quot;color: #e5c07b;&quot;&gt;string&lt;/span&gt;, &lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;// React Element的key&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: #ef596f;&quot;&gt; elementType&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;any&lt;/span&gt;, &lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;// React Element的type&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;type&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;any&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(127, 132, 142); font-style: italic;&quot;&gt;// 异步组件resolved之后返回的内容，一般是`function`或者`class`&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: #ef596f;&quot;&gt; stateNode&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;any&lt;/span&gt;, &lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;// 跟当前Fiber相关本地状态（比如浏览器环境就是DOM节点）&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;child&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;Fiber&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt; | null, &lt;/span&gt;&lt;span style=&quot;color: rgb(127, 132, 142); font-style: italic;&quot;&gt;// 指向第一个子节点&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;span style=&quot;color: #ef596f;&quot;&gt;sibling&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;Fiber&lt;/span&gt; | null, &lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;//指向下一个兄弟节点&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;span style=&quot;color: #ef596f;&quot;&gt;index&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;number&lt;/span&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;color: rgb(127, 132, 142); font-style: italic; background-color: rgb(255, 255, 255);&quot;&gt;// ref 可以是字符串函数或createRef生成的&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: #ef596f;&quot;&gt; ref&lt;/span&gt;: null | (((&lt;span style=&quot;color: #ef596f;font-style: italic;&quot;&gt;handle&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;mixed&lt;/span&gt;) &lt;span style=&quot;color: #d55fde;font-style: italic;&quot;&gt;=&amp;gt;&lt;/span&gt; &lt;span style=&quot;color: #e5c07b;&quot;&gt;void&lt;/span&gt;) &amp;amp; {&lt;span style=&quot;color: #ef596f;&quot;&gt;_stringRef&lt;/span&gt;: &lt;span style=&quot;color: #d55fde;&quot;&gt;?&lt;/span&gt;&lt;span style=&quot;color: #e5c07b;&quot;&gt;string&lt;/span&gt;}) | &lt;span style=&quot;color: #e5c07b;&quot;&gt;RefObject&lt;/span&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt; pendingProps&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;any&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(127, 132, 142); font-style: italic;&quot;&gt;//新的props&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;span style=&quot;color: #ef596f;&quot;&gt;memoizedProps&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;any&lt;/span&gt;, &lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt; // 上次的props&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt; updateQueue&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;UpdateQueue&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;any&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;gt; | null, &lt;/span&gt;&lt;span style=&quot;color: rgb(127, 132, 142); font-style: italic;&quot;&gt;// update更新队列&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt; memoizedState&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;any&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(127, 132, 142); font-style: italic;&quot;&gt;// 上次额state&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(127, 132, 142); font-style: italic;&quot;&gt;// 依赖的context链表&lt;/span&gt;&lt;span style=&quot;color: rgb(127, 132, 142); font-style: italic;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: #ef596f;&quot;&gt; contextDependencies&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;ContextDependencyList&lt;/span&gt; | null,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;mode&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;TypeOfMode&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(127, 132, 142); font-style: italic;&quot;&gt;// 渲染的mode&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;// Effect&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;span style=&quot;color: #ef596f;&quot;&gt;effectTag&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;SideEffectTag&lt;/span&gt;, &lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;// 记录side effect&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: #ef596f;&quot;&gt; nextEffect&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;Fiber&lt;/span&gt; | null, &lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;// 下一个side effect&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: #ef596f;&quot;&gt; firstEffect&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;Fiber&lt;/span&gt; | null, &lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;// 第一个side effect&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;span style=&quot;color: #ef596f;&quot;&gt;lastEffect&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;Fiber&lt;/span&gt; | null, &lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;// 最后一个side effect&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt; // 作用在渲染之前&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;// expirationTime === Sync则执行同步更新否则异步更新&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;span style=&quot;color: #ef596f;&quot;&gt;expirationTime&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;ExpirationTime&lt;/span&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;// nextExpirationTimeToWorkOn作用在渲染时即renderRoot函数开始时和结束时&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;// 用于在此次更新时渲染的优先级, 判断每个节点在此次更新中是否需要被更新&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;color: rgb(127, 132, 142); font-style: italic;&quot;&gt;// 确定子树中是否有不在等待的变化&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;childExpirationTime&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;ExpirationTime&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;, &lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: #ef596f;&quot;&gt; alternate&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;Fiber&lt;/span&gt; | null, &lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;// current &amp;lt;==&amp;gt; workInProgress&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt; // 下面的几个字段是为了在debug插件时收集fiber渲染的耗时&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;span style=&quot;color: #ef596f;&quot;&gt;actualDuration&lt;/span&gt;&lt;span style=&quot;color: #d55fde;&quot;&gt;?&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;number&lt;/span&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: #ef596f;&quot;&gt; actualStartTime&lt;/span&gt;&lt;span style=&quot;color: #d55fde;&quot;&gt;?&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;number&lt;/span&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt; selfBaseDuration&lt;/span&gt;&lt;span style=&quot;color: rgb(213, 95, 222);&quot;&gt;?&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;number&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: #ef596f;&quot;&gt; treeBaseDuration&lt;/span&gt;&lt;span style=&quot;color: #d55fde;&quot;&gt;?&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;number&lt;/span&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(171, 178, 191); background-color: rgb(255, 255, 255);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(127, 132, 142); font-style: italic;&quot;&gt;// __DEV__ only&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;span style=&quot;color: #ef596f;&quot;&gt;_debugID&lt;/span&gt;&lt;span style=&quot;color: #d55fde;&quot;&gt;?&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;number&lt;/span&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;span style=&quot;color: #ef596f;&quot;&gt;_debugSource&lt;/span&gt;&lt;span style=&quot;color: #d55fde;&quot;&gt;?&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;Source&lt;/span&gt; | null,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(1