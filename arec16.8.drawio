        <mxCell id="S1GNeYo4WOAbKDjL4fGL-57" value="&lt;div style=&quot;font-family: &amp;quot;Fira code&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 18px; line-height: 24px; white-space: pre;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;/*!!需要注意通过&lt;/span&gt;&lt;font color=&quot;#ff3333&quot;&gt;createElement&lt;/font&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;创建的对象&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;$$typeof都是&lt;/span&gt;&lt;font color=&quot;#ff3333&quot;&gt;REACT_ELEMENT_TYPE&lt;/font&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;而&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;通过&lt;/span&gt;&lt;font color=&quot;#ff3333&quot;&gt;createPortal&lt;/font&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;创建的对象$$typeof&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;都是&lt;/span&gt;&lt;font color=&quot;#ff3333&quot;&gt;REACT_PORTAL_TYPE&lt;/font&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;!!*/&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;element&lt;/span&gt; &lt;span style=&quot;color: rgb(43, 186, 197);&quot;&gt;=&lt;/span&gt; {&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;$$typeof&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;REACT_ELEMENT_TYPE&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;,&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;type&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;type&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;,&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;key&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;key&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;,&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;ref&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;ref&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;,&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;props&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;props&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;,&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;_owner&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;: &lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;ReactCurrentOwner&lt;/span&gt;.&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;current&lt;/span&gt;,&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;/*仅dev才有的属性*/&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;_self: __self,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;_source: __source&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;// 标识源码所在的位置&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;_store: {validated: false}&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(171, 178, 191);&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;};&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
