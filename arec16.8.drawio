        <mxCell id="S1GNeYo4WOAbKDjL4fGL-179" value="&lt;div style=&quot;color: rgb(171, 178, 191); font-family: &amp;quot;Fira code&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 18px; line-height: 24px; white-space: pre;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: rgb(97, 175, 239); font-style: italic;&quot;&gt;createHostRootFiber(&lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111); font-style: italic;&quot;&gt;isConcurrent&lt;/span&gt;&lt;span style=&quot;color: rgb(97, 175, 239); font-style: italic;&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Fira code&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 18px; line-height: 24px; white-space: pre;&quot;&gt;&lt;font color=&quot;#61afef&quot;&gt;&lt;i style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;根据isConcuurrent修改mode和更加dev环境是否有插件等修改mode&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Fira code&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 18px; line-height: 24px; white-space: pre;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;&quot; color=&quot;#61afef&quot;&gt;&lt;i&gt;返回&lt;/i&gt;&lt;/font&gt;&lt;span style=&quot;color: rgb(97, 175, 239); font-style: italic;&quot;&gt;createFiber&lt;/span&gt;&lt;span style=&quot;color: rgb(171, 178, 191);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;HostRoot&lt;/span&gt;&lt;span style=&quot;color: rgb(171, 178, 191);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(209, 154, 102);&quot;&gt;null&lt;/span&gt;&lt;span style=&quot;color: rgb(171, 178, 191);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(209, 154, 102);&quot;&gt;null&lt;/span&gt;&lt;span style=&quot;color: rgb(171, 178, 191);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(239, 89, 111);&quot;&gt;mode&lt;/span&gt;&lt;span style=&quot;color: rgb(171, 178, 191);&quot;&gt;),&lt;/span&gt;&lt;span style=&quot;color: rgb(229, 192, 123);&quot;&gt;HostRoot是WorkTag&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
